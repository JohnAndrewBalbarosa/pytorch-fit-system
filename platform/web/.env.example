# Canonical Next.js frontend -> local FastAPI service (server-side only)
PYTORCH_FIT_API_URL=http://127.0.0.1:8000

# Exactly one product data provider is active per environment.
# local: normalized reads from the local FastAPI/SQLite services.
# supabase: authenticated reads through the Supabase product_view RPC.
PYTORCH_FIT_DATA_PROVIDER=local

# Optional visual fallback. Off by default; never replaces a valid empty live response.
PYTORCH_FIT_DEMO_DATA=0

# Explicit local developer access. Never enable in production.
PYTORCH_FIT_DEV_ACCESS=1
PYTORCH_FIT_DEV_BYPASS_SIGN_IN=1
PYTORCH_FIT_DEV_USER_ID=00000000-0000-4000-8000-000000000001
PYTORCH_FIT_DEV_API_TOKEN=replace-with-a-long-local-random-value

# Required for Supabase Auth and the production data provider.
# The anon key is intentionally browser-safe; never expose the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only and reserved for validated gateway commands/background ingestion.
# Never prefix this value with NEXT_PUBLIC_ and never import it into client components.
SUPABASE_SERVICE_ROLE_KEY=

# Optional live job-market provider
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
